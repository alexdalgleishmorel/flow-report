# Local dev (.env.local): the Function URL's CORS config doesn't allow
# localhost, so the Vite dev server proxies the data fetch. Point
# DATA_PROXY_TARGET at the reader Lambda Function URL (Terraform output:
# `terraform -chdir=infra output -raw data_api_url`) and keep
# VITE_DATA_API_URL=/data-api.
VITE_DATA_API_URL=/data-api
DATA_PROXY_TARGET=https://REPLACE_ME.lambda-url.us-east-1.on.aws/

# Production (GitHub Actions repo variable): set VITE_DATA_API_URL to the
# full Function URL; DATA_PROXY_TARGET is not used.
